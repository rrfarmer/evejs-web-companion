# Deny everything, then allow exactly the trees the image needs. Keeps host
# caches, the icon cache, logs and the scraped gameStore out of the build
# context sent to the Linux builder.
**

!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!src/
!src/**
!contracts/
!contracts/**
!scripts/
!scripts/**
!web/
!web/**
!plugins/
!plugins/**

# ...minus the parts of those trees that must never be baked in.
**/node_modules
**/node_modules/**
src/**/*.test.js
**/.env
**/.env.*
