{
  "description": "Fleet companions: the Hangar's tick gives a squad its FLY and survives a reload, FLY outside a fleet says why, and the Companions window flies a pilot in the tab and stops it.",
  "recipe": "pi-colonies",
  "watch": { "pilot": "e2epi" },
  "setup": [
    { "login": { "user": "e2eagent", "name": "Agent Observer" }, "note": "the held session: never a pilot the web client flies" },
    "webUp",
    { "webLogin": "e2epi" },
    { "webClick": { "role": "button", "name": "All squads (0)" } },
    { "webClick": { "role": "button", "name": "+ New squad" } },
    { "webFill": { "role": "textbox", "name": "Name" }, "value": "Wing" },
    { "webClick": { "role": "button", "name": "Create squad" } },
    { "webClick": { "role": "button", "name": "Manage", "exact": true } },
    { "webClick": { "role": "button", "name": "Squads (0)" } },
    { "webClick": { "css": ".hangar-squadmenu-row" } },
    { "webClick": { "role": "checkbox", "name": "Flies as companion" } },
    { "webClick": { "css": ".hangar-squadmenu-done" } },
    { "webClick": { "role": "button", "name": "Done", "exact": true } },
    { "webExpect": { "role": "button", "name": "FLY", "exact": true }, "timeout": 10 },
    { "webShot": "the tick gave the squad its FLY" },
    { "webOpen": "/" },
    { "webExpect": { "role": "button", "name": "FLY", "exact": true }, "timeout": 30, "note": "the tick survived a reload" },
    { "webClick": { "role": "button", "name": "FLY", "exact": true } },
    { "webExpect": { "text": "Join a fleet first" }, "timeout": 30, "note": "refused with its reason, not started" },
    { "webShot": "FLY with no fleet" },
    { "webClick": { "role": "button", "name": "▶ ALL", "index": 0 } },
    { "webClick": { "role": "button", "name": "Go to first pilot" } },
    { "wait": 8, "note": "drone recovery checks a pilot that has just signed in" },
    { "webClick": { "role": "button", "name": "Fleet", "exact": true, "index": 0 } },
    { "webClick": { "role": "button", "name": "Form fleet" } },
    { "webExpect": { "text": "1 member" }, "timeout": 20, "note": "the pilot is in a fleet" },
    { "webClick": { "role": "button", "name": "Companions", "index": 0 } },
    { "webSelect": { "role": "combobox", "name": "Add a pilot" }, "option": "PI Hauler" },
    { "webClick": { "role": "button", "name": "Add", "exact": true } },
    { "webClick": { "role": "button", "name": "Start", "exact": true, "within": { "role": "region", "name": "Fleet companions" } }, "note": "with no fleet named above, the pilot waits for this press" },
    { "webExpect": { "role": "button", "name": "Fleet companions - 1 flying", "index": 0 }, "timeout": 60, "note": "the launcher counts a companion in the tab" },
    { "wait": 3 },
    { "webShot": "flying in the tab" },
    { "webClick": { "role": "button", "name": "Stop all" } },
    { "webExpect": { "role": "button", "name": "Fleet companions - 1 flying" }, "hidden": true, "timeout": 30, "note": "the window's Stop all stopped it" },
    { "webShot": "stopped in the tab" }
  ],
  "until": { "any": ["WEB what=up"], "from": "start", "timeout": 30, "grace": 1 },
  "expect": [
    { "match": "WEB what=up", "note": "the web client ran against this tree's server" },
    { "match": "PILOT online=true", "note": "the pilot came online" },
    { "match": "no WEB_ERROR what=exception", "note": "the page threw nothing" }
  ]
}
