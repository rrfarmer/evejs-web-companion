{
  "description": "A companion in a fight whose armour falls fast leaves at once: it warps out without waiting for its drones. The boss undocks and the companion follows it out; rats are spawned on the companion; then its armour is set lower every two seconds, faster than any wait for drones could survive.",
  "recipe": "companion-fight",
  "watch": { "pilot": "e2eflee" },
  "setup": [
    { "login": { "user": "e2efc", "name": "Fleet Boss" }, "note": "the held session, and the fleet's boss: never a pilot the web client flies" },
    { "slash": "/invu on", "note": "rats leave the boss alone" },
    "webUp",
    { "webLogin": "e2eflee" },
    { "webClick": { "role": "button", "name": "▶ ALL", "index": 0 } },
    { "webClick": { "role": "button", "name": "Go to first pilot" } },
    { "wait": 8, "note": "drone recovery checks a pilot that has just signed in" },
    { "fleetForm": ["e2eflee"], "note": "the held character is the boss, so the companion has a commander who is not a server run" },
    { "webClick": { "role": "button", "name": "Yes", "exact": true, "within": { "role": "alertdialog" } }, "timeout": 20, "note": "the page answers the invitation, so it holds the fleet as a player's client does" },
    { "webExpect": { "role": "alertdialog" }, "hidden": true, "timeout": 20 },
    { "webClick": { "role": "button", "name": "Companions", "index": 0 } },
    { "webSelect": { "role": "combobox", "name": "Add a pilot" }, "option": "Flee Pilot" },
    { "webClick": { "role": "button", "name": "Add", "exact": true } },
    { "webClick": { "role": "button", "name": "Start", "exact": true, "within": { "role": "region", "name": "Fleet companions" } } },
    { "webExpect": { "role": "button", "name": "Fleet companions - 1 flying", "index": 0 }, "timeout": 60 },
    "undock",
    { "waitFor": "GRID", "timeout": 120, "note": "the companion followed its boss out" },
    { "wait": 5 },
    { "slash": "/tr me offset=0,0,2000000000", "note": "far off the station's grid, so getting clear is a warp, not a dock" },
    { "pilotSlash": "/tr me offset=0,0,2000000000", "user": "e2eflee", "note": "the same jump from the same undock, so the two land together" },
    { "wait": 8 },
    { "pilotSlash": "/npc 5 parity_blood_raider_pulse_frigate", "user": "e2eflee", "note": "enough frigates that the fight is still on when the armour falls" },
    { "wait": 14, "note": "the companion fights: its drones go out about 9 s after the rats arrive" },
    { "webShot": "fighting" },
    { "shipHealth": { "shield": 0, "armor": 0.6 }, "user": "e2eflee" },
    { "wait": 2 },
    { "shipHealth": { "shield": 0, "armor": 0.45 }, "user": "e2eflee" },
    { "wait": 2 },
    { "shipHealth": { "shield": 0, "armor": 0.25 }, "user": "e2eflee", "note": "under the 30% flee floor, falling about 9% a second" },
    { "wait": 25, "note": "time to align, warp and land" },
    { "webShot": "after the flee" },
    { "webClick": { "role": "button", "name": "Stop all" } },
    { "botWait": "e2eflee", "timeout": 60 }
  ],
  "until": { "any": ["BOT what=end"], "from": "start", "timeout": 30, "grace": 1 },
  "expect": [
    { "match": "BOT what=phase phase~clear", "note": "the companion fled" },
    { "match": "BOT what=issue phase~clear says~warp", "note": "and warped" },
    { "match": "no BOT what=issue phase~clear says~recallDrones", "note": "without waiting for its drones" },
    { "match": "no DESTROYED self", "note": "the ship lived" },
    { "match": "no WEB_ERROR what=exception", "note": "the page threw nothing" }
  ]
}
