{
  "description": "PI Manager: a haul by a pilot with no ship that has a planetary hold stops and says why before anything is launched, and the player can stop it.",
  "recipe": "pi-colonies",
  "watch": { "pilot": "e2epi2" },
  "setup": [
    { "login": { "user": "e2eagent", "name": "Agent Observer" }, "note": "the held session: never a pilot the web client flies" },
    { "colonyAge": 8, "user": "e2epi2" },
    "webUp",
    { "webLogin": "e2epi2" },
    { "webClick": { "role": "button", "name": "Planetary Industry" } },
    { "webSelect": { "role": "combobox", "name": "Add" }, "option": "PI Launcher" },
    { "webClick": { "role": "button", "name": "Add", "exact": true } },
    { "webClick": { "role": "tab", "name": "Colonies" } },
    { "webClick": { "role": "button", "name": "Refresh" } },
    { "webClick": { "role": "checkbox", "name": "Haul from Amamake II", "exact": true } },
    { "webClick": { "role": "button", "name": "Haul 1 colony" } },
    { "botWait": "e2epi2", "timeout": 180 },
    { "wait": 3, "note": "the board keeps the run's own line until the bot has let go of the pilot" },
    { "webClick": { "role": "button", "name": "Refresh" } },
    { "webExpect": { "role": "region", "name": "PI Launcher's colonies" }, "text": "Epithal", "timeout": 20, "note": "the hint names the hull it needs" },
    { "webShot": "the haul stopped, and says why" },
    { "webClick": { "within": { "role": "region", "name": "PI Launcher's colonies" }, "role": "button", "name": "Stop", "exact": true }, "note": "a paused hosted bot doesn't carry on; Stop ends it" },
    { "webExpect": { "within": { "role": "region", "name": "PI Launcher's colonies" }, "role": "button", "name": "Stop", "exact": true }, "count": 0, "timeout": 20 },
    { "webExpect": { "role": "region", "name": "PI Launcher's colonies" }, "text": "Stopped", "note": "the board says the run ended" },
    { "colonyRead": "e2epi2" }
  ],
  "until": { "any": ["COLONY user=e2epi2"], "from": "start", "timeout": 30, "grace": 3 },
  "expect": [
    { "match": "BOT what=end status=paused", "note": "the bot paused rather than going on without a hold" },
    { "match": "no BOT says~\"from command centre\"", "note": "nothing was launched, so no tax was paid and no container left in space" },
    { "match": "COLONY user=e2epi2 commandUnits>0", "note": "the server says the goods are still in the command centre" },
    { "match": "no WEB_ERROR what=exception", "note": "the page threw nothing" },
    { "match": "no WEB_ERROR what=response", "note": "no API call answered 5xx" }
  ]
}
